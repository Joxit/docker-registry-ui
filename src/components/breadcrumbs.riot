<breadcrumbs>
  <nav aria-label="Breadcrumb" class="breadcrumbs" if="{ state.show }">
    <ol>
      <li>
        <a href="{ router.home() }" title="Repositories">
          <i class="material-icons">view_list</i>
          <span>Repositories</span>
        </a>
      </li>
      <template each="{ part in state.namespaceParts }">
        <li class="separator" aria-hidden="true">/</li>
        <li><span>{ part }</span></li>
      </template>
      <template if="{ state.imageName }">
        <li class="separator" aria-hidden="true">/</li>
        <li>
          <a href="{ router.taglist(state.image) }" title="{ state.image }">{ state.imageName }</a>
        </li>
      </template>
      <template if="{ state.tag }">
        <li class="separator" aria-hidden="true">/</li>
        <li aria-current="page"><span>{ state.tag }</span></li>
      </template>
    </ol>
  </nav>
  <script>
    import router from '../scripts/router';
    import { getCurrentRoute, router as routeRouter } from '@riotjs/route';

    const parseRoute = (route) => {
      const tagList = route.match(/taglist\/(.*)$/);
      if (tagList) {
        return { image: tagList[1] };
      }
      const tagHistory = route.match(/taghistory\/image\/(.*)\/tag\/([^/]*)\/?$/);
      if (tagHistory) {
        return { image: tagHistory[1], tag: tagHistory[2] };
      }
      return {};
    };

    export default {
      onMounted(props, state) {
        const update = () => {
          const { image, tag } = parseRoute(getCurrentRoute());
          const imageParts = (image || '').split('/').filter(Boolean);
          this.update({
            show: Boolean(image),
            image,
            tag: tag || '',
            imageName: imageParts[imageParts.length - 1] || '',
            namespaceParts: imageParts.slice(0, -1),
          });
        };
        routeRouter.on.value(update);
        update();
      },
      router,
    };
  </script>
  <style>
    :host .breadcrumbs {
      margin: 0 auto;
      max-width: 95%;
      padding: var(--space-2) var(--space-2) 0;
      @media screen and (min-width: 1515px) {
        max-width: 1440px;
      }
    }

    :host ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: var(--space-1);
    }

    :host li {
      display: inline-flex;
      align-items: center;
      font-size: var(--type-body-medium-size);
      line-height: var(--type-body-medium-height);
      color: var(--m3-on-surface-variant);
      white-space: nowrap;
    }

    :host li a {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      color: var(--m3-on-surface-variant);
      text-decoration: none;
      border-radius: var(--shape-sm);
      padding: var(--space-1) var(--space-1);
      transition: background-color var(--motion-duration-short) var(--motion-easing-standard);
    }

    :host li a:hover {
      background-color: var(--m3-state-hover);
      color: var(--m3-on-surface);
    }

    :host li a:focus-visible {
      outline: 2px solid var(--m3-primary);
      outline-offset: 2px;
    }

    :host li .material-icons {
      font-size: 18px;
    }

    :host li.separator {
      color: var(--m3-outline);
      user-select: none;
    }

    :host li[aria-current='page'] span {
      color: var(--m3-on-surface);
      font-weight: var(--type-label-large-weight);
      max-width: 16em;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    :host li > span:not([class]) {
      max-width: 16em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>
</breadcrumbs>
