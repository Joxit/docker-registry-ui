<catalog-element>
  <div
    class="content"
    if="{!props.filterResults || state.nImages > 0 || matchSearch(props.filterResults, state.image)}"
  >
    <div class="tree-node { state.expanded ? 'expanded' : '' }">
      <div
        class="list-row { state.images ? 'is-group' : 'is-leaf' }"
        if="{ !props.showCatalogNbTags || props.showTagless || state.nbTags !== 0 }"
        onclick="{ state.images ? onClick : null }"
      >
        <a if="{ state.image }" class="row-main" href="{ router.taglist(state.image) }">
          <i class="material-icons row-icon">send</i>
          <span class="row-label">{ state.image }</span>
        </a>
        <div
          if="{ state.images }"
          class="row-main"
          role="button"
          tabindex="0"
          aria-expanded="{ state.expanded }"
          onkeyup="{ onKeyUp }"
        >
          <i class="material-icons row-icon">folder</i>
          <span class="row-label">{ state.repo }</span>
        </div>
        <span class="row-meta">
          <span if="{ state.images }" class="badge" title="{ state.nImages } images">{ state.nImages }</span>
          <span
            if="{ props.showCatalogNbTags && state.image }"
            class="badge badge--accent { state.nbTags === undefined ? 'is-pending' : '' }"
            title="{ state.nbTags === undefined ? 'Loading tag count…' : state.nbTags + ' tags' }"
          >
            <i class="material-icons badge-icon">sell</i>
            { state.nbTags === undefined ? '…' : state.nbTags }
          </span>
          <i if="{ state.images }" class="material-icons row-chevron { state.expanded ? 'expanded' : '' }">
            expand_more
          </i>
        </span>
      </div>
      <div class="tree-children { !state.expanded && !props.filterResults ? 'collapsed' : '' }">
        <catalog-element
          filter-results="{ props.filterResults }"
          registry-url="{ props.registryUrl }"
          on-notify="{ props.onNotify }"
          on-authentication="{ props.onAuthentication }"
          show-catalog-nb-tags="{ props.showCatalogNbTags }"
          show-tagless="{ props.showTagless }"
          counts="{ props.counts }"
          catalog-default-expanded="{ props.catalogDefaultExpanded }"
          is-registry-secured="{ props.isRegistrySecured }"
          each="{ item in state.images }"
          item="{ item }"
        ></catalog-element>
      </div>
    </div>
  </div>
  <script>
    import router from '../../scripts/router';
    import { matchSearch } from '../search-bar.riot';

    export default {
      onBeforeMount(props, state) {
        if (props.item.images && props.item.images.length === 1) {
          state.image = props.item.images[0];
        } else if (typeof props.item === 'string') {
          state.image = props.item;
        } else if (props.item.images && props.item.repo) {
          state.images = props.item.images;
          state.repo = props.item.repo;
          state.nImages = props.item.images.length;
          state.expanded = props.catalogDefaultExpanded;
        }
        if (props.showCatalogNbTags && state.image) {
          state.nbTags = props.counts && props.counts[state.image];
        }
      },
      onBeforeUpdate(props, state) {
        if (props.showCatalogNbTags && state.image) {
          state.nbTags = props.counts && props.counts[state.image];
        }
        if (props.filterResults && state.images) {
          state.nImages = state.images.filter((image) => matchSearch(props.filterResults, image)).length;
        } else {
          state.nImages = state.images && state.images.length;
        }
      },
      onClick() {
        const state = this.state;
        if (state.repo) {
          this.update({
            expanded: !state.expanded,
          });
        }
      },
      onKeyUp(event) {
        if (event.keyCode === 13 || event.keyCode === 32) {
          event.preventDefault();
          this.onClick();
        }
      },
      matchSearch,
      router,
    };
  </script>
  <style>
    :host .tree-node {
      position: relative;
    }

    :host .list-row {
      cursor: default;
    }

    :host .list-row.is-group {
      cursor: pointer;
    }

    :host .row-main {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex: 1;
      min-width: 0;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      border-radius: var(--radius-sm);
    }

    :host .row-main:hover {
      color: var(--accent);
    }

    :host .row-icon {
      font-size: 18px;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    :host .row-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-family: var(--font-mono);
      font-size: var(--fs-md);
    }

    :host .row-meta {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-left: auto;
      flex-shrink: 0;
    }

    :host .row-chevron {
      color: var(--text-muted);
      transition: transform var(--dur-normal) var(--ease-out);
    }

    :host .badge-icon {
      font-size: 14px;
    }

    :host .badge.is-pending {
      opacity: 0.7;
      min-width: 34px;
    }

    :host .badge.is-pending .badge-icon {
      opacity: 0.6;
    }

    :host .row-chevron.expanded {
      transform: rotate(180deg);
    }

    :host .tree-children {
      margin-left: var(--space-6);
      padding-left: var(--space-2);
      border-left: 1px solid var(--border);
    }

    :host .tree-children.collapsed {
      display: none;
    }

    @media screen and (max-width: 700px) {
      :host .tree-children {
        margin-left: var(--space-3);
        padding-left: var(--space-1);
      }
    }
  </style>
</catalog-element>
