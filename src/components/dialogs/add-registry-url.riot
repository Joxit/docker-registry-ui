<add-registry-url>
  <app-dialog title="Add a registry" opened="{ props.opened }" on-close="{ props.onClose }">
    <div class="add-registry-form">
      <text-field
        label="Server URL"
        placeholder="https://registry.example.com"
        icon="link"
        on-key-up="{ onKeyUp }"
      ></text-field>
      <p class="field-hint">Write your URL without /v2</p>
    </div>
    <div slot="footer">
      <button class="btn" onclick="{ props.onClose }" type="button">Cancel</button>
      <button class="btn btn--primary" onclick="{ add }" type="button">Add</button>
    </div>
  </app-dialog>
  <script>
    import { addRegistryServers } from '../../scripts/utils';
    import router from '../../scripts/router';

    export default {
      onKeyUp(event) {
        // if keyCode is Enter
        if (event.keyCode === 13) {
          this.add();
        }
      },
      add() {
        const input = this.$('input');
        if (!input || !input.value || input.value.length === 0) {
          return this.props.onNotify('The input field is empty. Please enter an url.', true);
        }
        if (!input.value.startsWith('http')) {
          return this.props.onNotify('The input field should start with http:// or https://.', true);
        }
        if (/\/v2\/?$/.test(input.value)) {
          return this.props.onNotify('The input field should not end with /v2, the UI appends it itself.', true);
        }
        const url = addRegistryServers(input.value);
        router.home();
        this.props.onServerChange(url);
        this.props.onClose();
        setTimeout(() => router.updateUrlQueryParam(url), 100);
      },
    };
  </script>
  <style>
    :host .add-registry-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    :host .field-hint {
      font-size: var(--fs-md);
      color: var(--text-muted);
      margin: 0;
    }
  </style>
</add-registry-url>
