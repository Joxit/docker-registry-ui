<dialogs-menu>
  <add-registry-url
    if="{ !props.readOnlyRegistries }"
    opened="{ state['add-registry-url'] }"
    on-close="{ onClose('add-registry-url') }"
    on-notify="{ props.onNotify }"
    on-server-change="{ props.onServerChange }"
  ></add-registry-url>
  <change-registry-url
    opened="{ state['change-registry-url'] }"
    on-close="{ onClose('change-registry-url') }"
    on-notify="{ props.onNotify }"
    on-server-change="{ props.onServerChange }"
  ></change-registry-url>
  <remove-registry-url
    if="{ !props.readOnlyRegistries }"
    opened="{ state['remove-registry-url'] }"
    on-close="{ onClose('remove-registry-url') }"
    on-notify="{ props.onNotify }"
    on-server-change="{ props.onServerChange }"
  ></remove-registry-url>
  <div class="registry-menu">
    <material-button
      onClick="{ onClick }"
      waves-center="true"
      waves-opacity="0.6"
      waves-duration="600"
      color="var(--m3-header-background)"
      text-color="var(--m3-header-text)"
      title="{ props.registryUrl || 'Select a registry' }"
      aria-label="Switch registry"
    >
      <span class="registry-label">{ stripHttps(props.registryUrl) || 'Registry' }</span>
      <i class="material-icons">{ state.isDropdownOpened ? 'expand_less' : 'expand_more' }</i>
    </material-button>
    <material-dropdown
      items="{ dropdownItems }"
      selected="{ state.selectedRegistry }"
      on-click="{ onDropdownSelect }"
      opened="{ state.isDropdownOpened }"
    ></material-dropdown>
  </div>
  <div class="overlay" onclick="{ onClick }" if="{ state.isDropdownOpened }"></div>
  <script>
    import AddRegistryUrl from './add-registry-url.riot';
    import ChangeRegistryUrl from './change-registry-url.riot';
    import RemoveRegistryUrl from './remove-registry-url.riot';
    import { getRegistryServers, stripHttps } from '../../scripts/utils';
    import router from '../../scripts/router';

    const REGISTRY_PREFIX = 'registry:';

    export default {
      components: {
        AddRegistryUrl,
        ChangeRegistryUrl,
        RemoveRegistryUrl,
      },
      onBeforeMount(props, state) {
        this.rebuildItems(props, state);
      },
      onUpdated(props, state) {
        this.rebuildItems(props, state);
      },
      rebuildItems(props, state) {
        const registries = getRegistryServers().map((url) => ({
          title: stripHttps(url),
          name: REGISTRY_PREFIX + url,
        }));
        const actions = [
          {
            title: 'Add registry',
            name: 'add-registry-url',
            ro: false,
          },
          {
            title: 'Change registry',
            name: 'change-registry-url',
            ro: true,
          },
          {
            title: 'Remove registry',
            name: 'remove-registry-url',
            ro: false,
          },
        ].filter((item) => item.ro || !props.readOnlyRegistries);
        state.selectedRegistry = registries.findIndex((item) => item.name === REGISTRY_PREFIX + props.registryUrl);
        state.dropdownItems = registries.concat(actions);
      },
      onDropdownSelect(event) {
        const name = event.target.item;
        if (name && name.startsWith(REGISTRY_PREFIX)) {
          const url = name.slice(REGISTRY_PREFIX.length);
          router.home();
          this.props.onServerChange(url);
          setTimeout(() => router.updateUrlQueryParam(url), 100);
        } else if (name) {
          this.update({
            [name]: true,
          });
        }
        this.update({ isDropdownOpened: false });
      },
      onClose(name) {
        return () => {
          this.update({
            [name]: false,
            isDropdownOpened: false,
          });
        };
      },
      onClick() {
        this.update({
          isDropdownOpened: !this.state.isDropdownOpened,
        });
      },
      getRegistryServers,
      stripHttps,
    };
  </script>
  <style>
    :host > .registry-menu {
      color: var(--primary-text);
      position: relative;
      margin-block-start: 0.7em;
    }
    :host material-button > :first-child {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      padding: 0 var(--space-2);
      max-width: 260px;
    }
    :host .registry-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: var(--type-label-large-size);
      font-weight: var(--type-label-large-weight);
    }
    :host material-button .content i.material-icons {
      font-size: 20px;
      flex-shrink: 0;
    }
    material-dropdown .material-dropdown-container,
    material-dropdown .material-dropdown-container .material-dropdown-item {
      background-color: var(--m3-surface-container);
      color: var(--m3-on-surface);
    }
    material-dropdown .material-dropdown-container .material-dropdown-item:hover {
      background-color: var(--m3-state-hover);
    }
    material-dropdown .material-dropdown-container .material-dropdown-item.selected {
      background-color: var(--m3-secondary-container);
      color: var(--m3-on-secondary-container);
    }
    :host .registry-menu material-dropdown .material-dropdown-container {
      right: 0;
      top: 2.5em;
      width: max-content;
      min-width: 240px;
      max-width: 340px;
    }
    :host .overlay {
      position: fixed;
      height: 100%;
      width: 100%;
      top: 0;
      right: 0;
      z-index: 10;
    }
    :host material-button button {
      float: right;
      z-index: 2;
    }
    :host material-button .content {
      justify-content: flex-end;
    }
  </style>
</dialogs-menu>
