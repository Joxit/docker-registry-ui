<dockerfile>
  <app-dialog title="Dockerfile" opened="{ props.opened }" on-close="{ props.onClose }" wide="true">
    <div class="dockerfile-code">
      <template each="{ (_, idx) in props.elements }">
        <template
          each="{ element in props.elements[props.elements.length - 1 - idx].filter(e => e.key === 'created_by') }"
        >
          <div class="instruction">
            <span class="keyword">{ element.value }</span>
            <span>{ ' ' + element.content }</span>
          </div>
        </template>
      </template>
    </div>
    <div slot="footer">
      <button class="btn" onclick="{ props.onClose }" type="button">Close</button>
    </div>
  </app-dialog>
  <style>
    :host .dockerfile-code {
      background-color: var(--surface-muted);
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      overflow-x: auto;
    }
    :host .instruction {
      font-family: var(--font-mono);
      margin: 0.75em 0;
      line-height: var(--lh-normal);
      white-space: pre-wrap;
      word-break: break-all;
    }
    :host .instruction:first-child {
      margin-top: 0;
    }
    :host .instruction:last-child {
      margin-bottom: 0;
    }
    :host .instruction .keyword {
      color: var(--accent);
      font-weight: 600;
    }
  </style>
</dockerfile>
