<pagination>
  <div class="pagination">
    <button
      each="{ (p, idx) in props.pages }"
      class="btn btn--sm { p.current ? 'is-current' : '' }"
      onclick="{(e) => props.onPageUpdate(idx)}"
      aria-label="page-{ p.page }"
      aria-current="{ p.current ? 'page' : null }"
      type="button"
    >
      <i if="{ p.icon }" class="material-icons">{ p.icon }</i>
      <template if="{ !p.icon }">{ p.page }</template>
    </button>
  </div>
  <style>
    :host .pagination {
      display: flex;
      justify-content: center;
      gap: 2px;
      flex-wrap: wrap;
      margin: var(--space-4) 0;
    }

    :host .btn.is-current {
      background-color: var(--accent-soft);
      color: var(--accent);
    }

    :host .btn.is-current:hover {
      background-color: var(--accent-soft-hover);
    }

    :host .btn .material-icons {
      font-size: 18px;
    }
  </style>
</pagination>
