<tag-history-button>
  <button
    if="{ props.image.ociImage }"
    class="btn btn--icon btn--sm"
    disabled="true"
    title="History is unavailable on OCI index/Buildkit export cache"
    type="button"
  >
    <i class="material-icons">history</i>
  </button>
  <a
    if="{ !props.image.ociImage }"
    class="btn btn--icon btn--sm"
    href="{ routeToHistory() }"
    title="This will show the history of given tag"
    aria-label="Show history of { props.image.name }:{ props.image.tag }"
  >
    <i class="material-icons">history</i>
  </a>
  <script>
    import router from '../../scripts/router';
    export default {
      routeToHistory() {
        return router.history(this.props.image.name, this.props.image.tag);
      },
    };
  </script>
</tag-history-button>
