<tag-table>
  <confirm-delete-image
    opened="{ state.confirmDeleteImage }"
    on-click="{ onConfirmDeleteImageClick }"
    registry-url="{ props.registryUrl }"
    on-notify="{ props.onNotify }"
    on-authentication="{ props.onAuthentication }"
    tags="{ props.tags }"
    to-delete="{ state.toDelete }"
    is-registry-secured="{ props.isRegistrySecured }"
    on-image-deleted="{ props.onImageDeleted }"
  ></confirm-delete-image>

  <div class="selection-bar" if="{ state.toDelete.size > 0 && !state.singleDeleteAction }">
    <span class="selection-count">{ state.toDelete.size } selected</span>
    <span class="selection-actions">
      <material-button
        text-color="var(--m3-on-surface-variant)"
        color="inherit"
        waves-color="var(--m3-state-hover)"
        waves-center="true"
        onClick="{ clearSelection }"
      >
        Clear
      </material-button>
      <material-button
        text-color="var(--m3-on-error-container)"
        color="var(--m3-error-container)"
        waves-color="var(--m3-on-error-container)"
        waves-center="true"
        onClick="{ deleteImages }"
      >
        Delete
      </material-button>
    </span>
  </div>

  <material-card class="taglist">
    <table style="border: none">
      <thead>
        <tr>
          <th class="select-col" if="{ props.isImageRemoveActivated }">
            <material-checkbox
              class="indeterminate"
              checked="{ state.multiDelete }"
              title="Toggle multi-delete. Alt+Click to select all tags."
              aria-label="Toggle multi-delete"
              onChange="{ onRemoveImageHeaderChange }"
            ></material-checkbox>
          </th>
          <th
            id="image-tag-header"
            class="sortable { !state.orderType ? (props.asc ? 'sorted-asc' : 'sorted-desc') : '' }"
            onclick="{ onReverseOrder }"
            aria-sort="{ !state.orderType ? (props.asc ? 'ascending' : 'descending') : 'none' }"
          >
            Tag
            <i if="{ getSortIcon('tag') }" class="material-icons sort-icon">{ getSortIcon('tag') }</i>
          </th>
          <th
            class="creation-date sortable { state.orderType === 'date' ? (state.desc ? 'sorted-desc' : 'sorted-asc') : '' }"
            onclick="{ () => onPageReorder('date') }"
            aria-sort="{ state.orderType === 'date' ? (state.desc ? 'descending' : 'ascending') : 'none' }"
          >
            Creation date
            <i if="{ getSortIcon('date') }" class="material-icons sort-icon">{ getSortIcon('date') }</i>
          </th>
          <th
            class="image-size sortable { state.orderType === 'size' ? (state.desc ? 'sorted-desc' : 'sorted-asc') : '' }"
            onclick="{ () => onPageReorder('size') }"
            aria-sort="{ state.orderType === 'size' ? (state.desc ? 'descending' : 'ascending') : 'none' }"
          >
            Size
            <i if="{ getSortIcon('size') }" class="material-icons sort-icon">{ getSortIcon('size') }</i>
          </th>
          <th class="architectures">Arch</th>
          <th id="image-content-digest-header" if="{ props.showContentDigest }">Content digest</th>
          <th class="show-tag-history" if="{ props.showTagHistory }">History</th>
        </tr>
      </thead>
      <tbody>
        <tr each="{ image in getPage(props.tags, props.page) }" if="{ matchSearch(props.filterResults, image.tag) }">
          <td class="select-col" if="{ props.isImageRemoveActivated }" data-label="Select">
            <remove-image
              multi-delete="{ state.multiDelete }"
              image="{ image }"
              registry-url="{ props.registryUrl }"
              handleCheckboxChange="{ onRemoveImageChange }"
              checked="{ state.toDelete.has(image) }"
              on-notify="{ props.onNotify }"
              on-authentication="{ props.onAuthentication }"
            ></remove-image>
          </td>
          <td class="tag-col" data-label="Tag">
            <image-tag image="{ image }"></image-tag>
            <copy-to-clipboard
              target="tag"
              image="{ image }"
              pull-url="{ props.pullUrl }"
              on-notify="{ props.onNotify }"
            ></copy-to-clipboard>
          </td>
          <td class="image-size" data-label="Size">
            <image-size image="{ image }"></image-size>
          </td>
          <td class="creation-date" data-label="Creation date">
            <image-date image="{ image }"></image-date>
          </td>
          <td class="architectures" data-label="Arch">
            <architectures image="{ image }"></architectures>
          </td>
          <td class="digest-col" if="{ props.showContentDigest }" data-label="Content digest">
            <image-content-digest image="{ image }"></image-content-digest>
            <copy-to-clipboard
              target="digest"
              image="{ image }"
              pull-url="{ props.pullUrl }"
              on-notify="{ props.onNotify }"
            ></copy-to-clipboard>
          </td>
          <td class="show-tag-history" if="{ props.showTagHistory }" data-label="History">
            <tag-history-button image="{ image }"></tag-history-button>
          </td>
        </tr>
      </tbody>
    </table>
  </material-card>

  <script>
    import { getPage } from '../../scripts/utils';
    import ImageDate from './image-date.riot';
    import ImageSize from './image-size.riot';
    import ImageTag from './image-tag.riot';
    import ImageContentDigest from './image-content-digest.riot';
    import CopyToClipboard from './copy-to-clipboard.riot';
    import TagHistoryButton from './tag-history-button.riot';
    import RemoveImage from './remove-image.riot';
    import Architectures from './architectures.riot';
    import { matchSearch } from '../search-bar.riot';
    import ConfirmDeleteImage from '../dialogs/confirm-delete-image.riot';
    const ACTION_CHECK_TO_DELETE = 'CHECK';
    const ACTION_UNCHECK_TO_DELETE = 'UNCHECK';
    const ACTION_DELETE_IMAGE = 'DELETE';

    export default {
      components: {
        ImageDate,
        ImageSize,
        ImageTag,
        ImageContentDigest,
        CopyToClipboard,
        RemoveImage,
        TagHistoryButton,
        ConfirmDeleteImage,
        Architectures,
      },
      onBeforeMount(props) {
        this.state = {
          toDelete: new Set(),
          multiDelete: false,
          page: props.page,
        };
      },
      onBeforeUpdate(props, state) {
        if (state.page !== props.page) {
          state.toDelete.clear();
        }
        state.page = props.page;
      },
      deleteImages() {
        this.update({
          confirmDeleteImage: true,
        });
      },
      clearSelection() {
        this.state.toDelete.clear();
        this.update({
          toDelete: this.state.toDelete,
          multiDelete: false,
          selectedImage: undefined,
        });
      },
      onConfirmDeleteImageClick() {
        if (this.state.singleDeleteAction) {
          this.state.toDelete.clear();
        }
        this.update({
          singleDeleteAction: false,
          confirmDeleteImage: false,
        });
      },
      onRemoveImageHeaderChange(event) {
        if (event.altKey === true) {
          const tags = getPage(this.props.tags, this.props.page);
          tags
            .filter((image) => matchSearch(this.props.filterResults, image.tag))
            .forEach((tag) => this.state.toDelete.add(tag));
          this.update({
            multiDelete: true,
            toDelete: this.state.toDelete,
            selectedImage: undefined,
          });
        } else {
          const checked = event.target.checked;
          if (!checked) {
            this.state.toDelete.clear();
          }
          this.update({
            multiDelete: checked,
            toDelete: this.state.toDelete,
            selectedImage: undefined,
          });
        }
      },
      onRemoveImageChange(action, image, shiftKey) {
        let confirmDeleteImage = false;
        let singleDeleteAction = false;
        let selectedImage = undefined;
        switch (action) {
          case ACTION_CHECK_TO_DELETE: {
            this.state.toDelete.add(image);
            if (shiftKey) {
              selectedImage = this.supportShiftKey(image, true);
            }
            break;
          }
          case ACTION_UNCHECK_TO_DELETE: {
            this.state.toDelete.delete(image);
            if (shiftKey) {
              selectedImage = this.supportShiftKey(image, false);
            }
            break;
          }
          case ACTION_DELETE_IMAGE: {
            this.state.toDelete.clear();
            this.state.toDelete.add(image);
            confirmDeleteImage = true;
            singleDeleteAction = true;
          }
        }
        this.update({
          toDelete: this.state.toDelete,
          confirmDeleteImage,
          singleDeleteAction,
          selectedImage,
        });
      },
      supportShiftKey(selectedImage, addOrRemove) {
        if (!this.state.selectedImage) {
          return selectedImage;
        } else {
          let shouldChange = false;
          const tags = this.getPage(this.props.tags, this.props.page);
          tags
            .filter((image) => {
              if (image == this.state.selectedImage || image == selectedImage) {
                shouldChange = !shouldChange;
                return true;
              }
              return shouldChange;
            })
            .forEach((image) => {
              if (addOrRemove) {
                this.state.toDelete.add(image);
              } else {
                this.state.toDelete.delete(image);
              }
            });
          return undefined;
        }
      },
      onReverseOrder() {
        this.state.orderType = null;
        this.state.desc = false;
        this.props.onReverseOrder();
      },
      onPageReorder(type) {
        this.update({
          orderType: type,
          desc: (this.state.orderType && this.state.orderType !== type) || !this.state.desc,
        });
      },
      getSortIcon(column) {
        if (column === 'tag' && !this.state.orderType) {
          return this.props.asc ? 'arrow_upward' : 'arrow_downward';
        }
        if (this.state.orderType === column) {
          return this.state.desc ? 'arrow_downward' : 'arrow_upward';
        }
        return '';
      },
      getPage(tags, page) {
        const sortedTags = getPage(tags, page, this.props.tagsPerPage);
        if (this.state.orderType === 'date') {
          sortedTags.sort((e1, e2) =>
            !this.state.desc
              ? (e2.creationDate?.getTime() || 0) - (e1.creationDate?.getTime() || 0)
              : (e1.creationDate?.getTime() || 0) - (e2.creationDate?.getTime() || 0)
          );
        } else if (this.state.orderType === 'size') {
          sortedTags.sort((e1, e2) => (!this.state.desc ? e2.size - e1.size : e1.size - e2.size));
        }
        return sortedTags;
      },
      matchSearch,
    };
    export { ACTION_CHECK_TO_DELETE, ACTION_UNCHECK_TO_DELETE, ACTION_DELETE_IMAGE };
  </script>
  <style>
    :host {
      display: block;
      position: relative;
    }

    :host table {
      border: none;
    }

    :host thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background-color: var(--m3-surface);
      text-align: left;
      font-size: var(--type-title-small-size);
      font-weight: var(--type-title-small-weight);
      line-height: var(--type-title-small-height);
      color: var(--m3-on-surface-variant);
      white-space: nowrap;
    }

    :host thead th.sorted-asc,
    :host thead th.sorted-desc {
      color: var(--m3-on-surface);
    }

    :host thead th[onclick],
    :host thead th.sortable {
      cursor: pointer;
    }

    :host thead th .sort-icon {
      font-size: 16px;
      vertical-align: middle;
      color: var(--m3-on-surface-variant);
    }

    :host .select-col {
      width: 56px;
      text-align: center;
    }

    :host .tag-col {
      max-width: 40vw;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :host .creation-date {
      width: 12em;
    }

    :host .image-size {
      width: 7em;
    }

    :host .architectures {
      text-align: center;
      width: 10em;
    }

    :host .digest-col {
      max-width: 24em;
      overflow: hidden;
    }

    :host .show-tag-history {
      width: 56px;
      text-align: center;
    }

    :host tbody tr {
      transition: background-color var(--motion-duration-short) var(--motion-easing-standard);
    }

    :host tbody tr:hover {
      background-color: var(--m3-state-hover);
    }

    :host td {
      color: var(--m3-on-surface);
      border-top: 1px solid var(--m3-outline-variant);
      border-bottom: 1px solid var(--m3-outline-variant);
    }

    :host .selection-bar {
      position: sticky;
      bottom: var(--space-4);
      margin: 0 auto var(--space-4);
      width: max-content;
      max-width: calc(100% - var(--space-8));
      display: flex;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--shape-full);
      background-color: var(--m3-inverse-surface);
      color: var(--m3-inverse-on-surface);
      box-shadow: var(--elevation-3);
      z-index: 20;
    }

    :host .selection-count {
      font-size: var(--type-label-large-size);
      font-weight: var(--type-label-large-weight);
      white-space: nowrap;
    }

    :host .selection-actions {
      display: flex;
      align-items: center;
    }

    @media screen and (max-width: 700px) {
      :host thead {
        display: none;
      }

      :host tbody tr {
        display: flex;
        flex-direction: column;
        padding: var(--space-3);
        margin: var(--space-3) 0;
        background-color: var(--m3-surface-container-low);
        border-radius: var(--shape-md);
        border: 1px solid var(--m3-outline-variant);
      }

      :host tbody tr:hover {
        background-color: var(--m3-surface-container-low);
      }

      :host td {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        height: auto;
        min-height: 40px;
        padding: var(--space-1) var(--space-2);
        border: none;
        text-align: left;
      }

      :host td::before {
        content: attr(data-label);
        font-size: var(--type-label-medium-size);
        font-weight: var(--type-label-medium-weight);
        color: var(--m3-on-surface-variant);
        flex-shrink: 0;
      }

      :host .select-col {
        position: absolute;
        top: var(--space-2);
        right: var(--space-2);
        width: auto;
      }

      :host .select-col::before {
        display: none;
      }

      :host .tag-col {
        max-width: none;
      }

      :host .architectures {
        width: auto;
      }

      :host .show-tag-history {
        width: auto;
      }
    }
  </style>
</tag-table>
